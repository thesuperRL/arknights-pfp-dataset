{
  "name": "arknights-pfp-dataset",
  "version": "1.0.0",
  "description": "Arknights operator profile pictures dataset with scraper",
  "main": "scraper.ts",
  "scripts": {
    "build": "tsc",
    "scrape": "ts-node scraper.ts",
    "scrape:1star": "ts-node scraper.ts 1",
    "scrape:2star": "ts-node scraper.ts 2",
    "scrape:3star": "ts-node scraper.ts 3",
    "scrape:4star": "ts-node scraper.ts 4",
    "scrape:5star": "ts-node scraper.ts 5",
    "scrape:6star": "ts-node scraper.ts 6",
    "scrape:skins": "ts-node scraper.ts 6 --skins",
    "scrape:all-skins": "ts-node scraper.ts 1 --skins && ts-node scraper.ts 2 --skins && ts-node scraper.ts 3 --skins && ts-node scraper.ts 4 --skins && ts-node scraper.ts 5 --skins && ts-node scraper.ts 6 --skins"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesuperRL/arknights-pfp-dataset.git"
  },
  "keywords": ["arknights", "dataset", "profile-pictures", "scraper"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^25.0.3",
    "@types/puppeteer": "^5.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "puppeteer": "^24.34.0"
  }
}
